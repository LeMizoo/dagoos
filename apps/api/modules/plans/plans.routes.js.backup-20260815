const express = require('express');
const prisma = require('../../lib/prisma');
const { authMiddleware } = require('../../middleware/auth');

const router = express.Router();

// Liste des plans actifs
router.get('/', authMiddleware, async (req, res) => {
  try {
    const plans = await prisma.plan.findMany({
      where: { active: true },
      orderBy: [{ type: 'asc' }, { price: 'asc' }],
    });

    res.json(plans);
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

// Modification d'un plan — SUPER_ADMIN uniquement
router.put('/:id', authMiddleware, async (req, res) => {
  try {
    if (req.user.role !== 'SUPER_ADMIN') {
      return res.status(403).json({
        error: 'Accès réservé au SUPER_ADMIN',
      });
    }

    const { price, vehiclesMax, driversMax, active } = req.body;

    const plan = await prisma.plan.update({
      where: { id: req.params.id },
      data: {
        ...(price !== undefined && { price: Number(price) }),
        ...(vehiclesMax !== undefined && { vehiclesMax: Number(vehiclesMax) }),
        ...(driversMax !== undefined && { driversMax: Number(driversMax) }),
        ...(active !== undefined && { active: Boolean(active) }),
      },
    });

    res.json(plan);
  } catch (e) {
    console.error('Erreur modification plan:', e);
    res.status(500).json({ error: e.message });
  }
});

module.exports = router;
