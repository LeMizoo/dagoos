generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("USER")
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  driver    Driver?
}

model Organization {
  id              String    @id @default(cuid())
  name            String
  code            String    @unique
  slug            String    @unique
  type            String
  email           String    @unique
  phone           String?
  logo            String?
  description     String?
  plan            String    @default("Freemium")
  paymentStatus   String?   @default("unpaid")
  paymentRef      String?
  paymentAmount   Int?
  subscriptionEnd DateTime?
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  drivers         Driver[]
  messages        Message[]
  vehicles        Vehicle[]
}

model Driver {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  driverCode     String       @unique
  pin            String
  license        String?
  vehicleId      String?
  status         String       @default("active")
  createdAt      DateTime     @default(now())
}

model Message {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  subject        String
  content        String
  sender         String        @default("Admin")
  reply          String?
  repliedAt      DateTime?
  repliedBy      String?
  type           String        @default("info")
  read           Boolean       @default(false)
  replied        Boolean       @default(false)
  createdAt      DateTime      @default(now())
}

model Vehicle {
  id                String        @id @default(cuid())
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  plate             String        @unique
  model             String?
  year              Int?
  currentKm         Int           @default(0)
  nextMaintenanceKm Int           @default(3000)
  insuranceDate     String?
  vignetteDate      String?
  status            String        @default("active")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Trip {
  id        String   @id @default(cuid())
  driverId  String
  vehicleId String
  status    String   @default("pending")
  startAt   DateTime?
  endAt     DateTime?
  createdAt DateTime @default(now())
}

model Payment {
  id     String @id @default(cuid())
  tripId String
  amount Float
  method String
}

model Plan {
  id          String   @id @default(cuid())
  type        String
  name        String
  price       Float    @default(0)
  vehiclesMax Int      @default(1)
  driversMax  Int      @default(1)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Course {
  id         String   @id @default(cuid())
  driverId   String
  vehicleId  String
  type       String   @default("NORMALE")
  distanceKm Float    @default(0)
  price      Float    @default(0)
  commission Float    @default(0)
  date       DateTime @default(now())
}

model Log {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())
}

model LandingContent {
  id       String  @id @default(cuid())
  section  String  @unique
  title    String?
  subtitle String?
  body     String?
  imageUrl String?
  active   Boolean @default(true)
}
